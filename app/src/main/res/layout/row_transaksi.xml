<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:strokeColor="#FBBF24"
    app:strokeWidth="1dp">

    <LinearLayout
        android:padding="12dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvNotaTanggal"
            android:text="TRX-xxx • 21/10/2025 10:33"
            android:textColor="#5B3412"
            android:textSize="15sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvKasirShift"
            android:text="Kasir: uid • Shift: abc"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvTotal"
            android:text="Total: Rp 0"
            android:textColor="#15803D"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLihat"
                style="@style/Widget.Material3.Button.TextButton"
                android:text="Lihat"
                android:textColor="#D97706"
                app:icon="@drawable/ic_visibility_24"
                app:iconTint="#D97706"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHapus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="Hapus"
                app:icon="@drawable/ic_delete_24"
                app:iconTint="#DC2626"
                android:textColor="#DC2626"
                android:strokeColor="#FCA5A5"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
