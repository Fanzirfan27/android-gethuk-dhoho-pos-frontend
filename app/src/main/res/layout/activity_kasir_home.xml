<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F0F9FF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Dashboard Kasir"
            android:textColor="#075985"
            android:textSize="22sp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:strokeColor="#BAE6FD"
            app:strokeWidth="1dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Status Shift"
                    android:textColor="#0C4A6E"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvShiftStatus"
                    android:text="Status: -"
                    android:textColor="#075985"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvShiftInfo"
                    android:text="(Belum ada shift aktif)"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRingkasanShift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:strokeColor="#BAE6FD"
            app:strokeWidth="1dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Ringkasan Shift"
                    android:textColor="#0C4A6E"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvTotalTransaksiShift"
                    android:text="Jumlah Transaksi: 0"
                    android:textColor="#0369A1"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvOmzetShift"
                    android:text="Omzet Shift: Rp 0"
                    android:textColor="#059669"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvModalAwal"
                    android:text="Modal Awal: Rp 0"
                    android:textColor="#0C4A6E"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvEstimasiCashSaatIni"
                    android:text="Estimasi Cash Saat Ini: Rp 0 (modal + omzet)"
                    android:textColor="#0369A1"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvCashAkhir"
                    android:text="Cash Akhir: -"
                    android:textColor="#0C4A6E"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvSelisih"
                    android:text="Selisih: -"
                    android:textColor="#DC2626"
                    android:textSize="15sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:strokeColor="#BAE6FD"
            app:strokeWidth="1dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnOpenShift"
                    android:text="Buka Shift"
                    android:backgroundTint="#0284C7"
                    android:textColor="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnCloseShift"
                    android:text="Tutup Shift"
                    android:backgroundTint="#0EA5E9"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnPos"
                    android:text="Masuk ke POS"
                    android:backgroundTint="#059669"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/btnChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chat Admin"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#009688"
                    android:textColor="@android:color/white" />
                <Button
                    android:id="@+id/btnMapsToko"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lihat Lokasi Toko"
                    android:layout_marginTop="8dp" />
                <Button
                    android:id="@+id/btnTiktok"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buka TikTok"
                    android:layout_marginTop="8dp"/>
                <Button
                    android:id="@+id/btnLogoutKasir"
                    android:text="Keluar"
                    android:backgroundTint="#DC2626"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
