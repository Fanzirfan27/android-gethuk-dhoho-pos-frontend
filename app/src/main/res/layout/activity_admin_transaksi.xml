<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:background="#FFF7ED"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Laporan Penjualan"
        app:titleCentered="false"
        android:backgroundTint="#D97706"
        app:titleTextColor="@android:color/black"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@android:color/black" />

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginTop="?attr/actionBarSize"
        android:background="#FFF7ED"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Cari (kasir / nota)"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#F59E0B"
                app:boxStrokeWidth="2dp"
                app:boxBackgroundColor="#FFFFFFFF"
                app:hintTextColor="#5B3412">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCari"
                    android:imeOptions="actionSearch"
                    android:textColor="#111827"
                    android:textCursorDrawable="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTanggal"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hari ini"
                android:textColor="@android:color/white"
                android:backgroundTint="#D97706" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_marginStart="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_refresh_24"
                app:iconTint="@android:color/white"
                android:backgroundTint="#D97706" />
        </LinearLayout>
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartOmzet"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_margin="12dp"/>

        <TextView
            android:id="@+id/tvChartTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grafik Omzet"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTransaksi"
            android:layout_marginTop="8dp"
            android:background="#FFF7ED"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:indeterminate="true"
            android:visibility="gone"
            android:indeterminateTint="#D97706"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvEmpty"
            android:text="Tidak ada transaksi"
            android:textColor="#5B3412"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"/>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnExportPdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Export PDF"
        android:layout_margin="16dp"
        android:src="@drawable/ic_pdf_24"
        app:tint="@android:color/white"
        app:backgroundTint="#D97706"
        app:layout_anchor="@id/rvTransaksi"
        app:layout_anchorGravity="bottom|end" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
